<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/passRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/passTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fg"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/passBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/secretInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch"
            android:layout_marginTop="20dp"
            android:background="@drawable/address_bg"
            android:hint="@string/secret_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/confirmInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch"
            android:layout_marginTop="8dp"
            android:background="@drawable/address_bg"
            android:hint="@string/confirm_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/currentInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch"
            android:layout_marginTop="8dp"
            android:background="@drawable/address_bg"
            android:hint="@string/current_secret_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted"
            android:visibility="gone" />

        <TextView
            android:id="@+id/passError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/danger"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/passSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/continue_label" />
    </LinearLayout>
</ScrollView>
